# ---- LLM provider (default: Google Gemini) ----
MODEL_PROVIDER=google            # "google" (Gemini, default) or "anthropic" (Claude)

# Gemini API key — either name works
GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...

# Model id. A single Flash key runs the whole agent (all tiers default here).
# Set to your exact model id, e.g. gemini-2.5-flash (or gemini-3.5-flash if your key exposes it).
GEMINI_MODEL=gemini-2.5-flash

# Optional per-tier overrides (default to GEMINI_MODEL):
# MODEL_CLASSIFY=gemini-2.5-flash
# MODEL_DRAFT=gemini-2.5-flash
# MODEL_PREMIUM=gemini-2.5-pro   # upgrade Tier-A drafting if your key allows

# ---- Anthropic alternative (only if MODEL_PROVIDER=anthropic) ----
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Database (prod checkpointer + commission tables) ----
DB_URL=postgresql://user:pass@localhost:5432/constrox_sdr

# ---- Compliance: org identity injected into every email ----
ORG_NAME=Constrox (ASISA Technologies LLP)
ORG_ADDRESS=Constrox, 123 Example St, City, Country
ORG_ABN=00 000 000 000

# ---- Human-in-the-loop toggles ----
GATE_HIGH_VALUE_EMAIL=false      # if true, Tier-A first-touch emails pause for human approval
